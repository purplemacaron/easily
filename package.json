{
  "name": "easily",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Easily — 업무 전용 데스크톱 에이전트 하네스",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @easily/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:features": "node scripts/gen-features-md.mjs",
    "site": "npx --yes serve site -l 4321"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
